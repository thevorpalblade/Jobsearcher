# Only the ones your config.yaml providers use are needed. Read by docker compose,
# and by `jobsearcher` itself from the directory containing config.yaml.
MOONSHOT_API_KEY=
# provider: nvidia (e.g. GLM on NVIDIA's serverless endpoints, build.nvidia.com)
NVIDIA_API_KEY=
# provider: zai (GLM from Z.ai, pay per token; z.ai > API keys)
ZAI_API_KEY=
# provider: gemini (Google AI Studio > Get API key; the free tier may use prompts for training)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# provider: claude_code — run `claude setup-token` on any machine with a browser and
# paste the printed token here. Uses your Claude Pro/Max subscription's usage limits.
CLAUDE_CODE_OAUTH_TOKEN=

# Address docker compose publishes the web UI on (default 0.0.0.0, all interfaces).
# Docker bypasses ufw/firewalld, so on a server with a public IP set a LAN or
# Tailscale address, e.g. WEB_BIND=192.168.1.10
# WEB_BIND=
